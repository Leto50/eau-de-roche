{
  "name": "eau-de-roche",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names convex,web --prefix-colors yellow,cyan \"convex dev\" \"vite dev --port 3000\"",
    "dev:web": "vite dev --port 3000",
    "dev:convex": "convex dev",
    "build": "vite build && node scripts/prepare-netlify.mjs",
    "build:netlify": "convex deploy --preview-run migrations:rebuildReadModels --cmd \"pnpm build\"",
    "preview": "vite preview",
    "preview:copy-data": "node scripts/copy-production-data-to-preview.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "seed": "convex run seed:importWorkbook"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.45.0",
    "lucide-react": "^1.41.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.56",
    "eslint": "^10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^7",
    "typescript-eslint": "^8.69.0",
    "vite": "^8",
    "vitest": "^5"
  }
}
